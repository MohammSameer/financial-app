# Copy to .env for local development. The defaults below already match
# docker-compose.yml, so an untouched copy works out of the box.

# Local Docker Postgres. Port 5544, not 5432 — see docker-compose.yml.
DATABASE_URL=postgresql://coinstack:coinstack@localhost:5544/coinstack

# Comma-separated. Add the deployed frontend origin here in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Rewards rules ---
# One coin per this many rupees of a successful payment.
COIN_RUPEES_PER_COIN=100
# Maximum coins any single transaction can earn. See ASSUMPTIONS.md.
COIN_CAP_PER_TXN=50

# Amounts at or above this are flagged as data errors and excluded from
# analytics. The dataset's 99.9th percentile is ~₹54,750.
OUTLIER_AMOUNT_THRESHOLD=100000
